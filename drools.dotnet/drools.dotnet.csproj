<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>org.drools.dotnet</RootNamespace>
    <AssemblyName>drools.dotnet</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Drools.NET</PackageId>
    <PackageVersion>2.0.0</PackageVersion>
    <PackageDescription>Rete-based Business Rule Engine for .NET</PackageDescription>
    <PackageAuthors>Sahi Technologies Pvt Ltd</PackageAuthors>
    <PackageTags>rules engine;business rules;rete;drools</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/your-repo/droolsdotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);SYSLIB0011;CS0618</NoWarn>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="drools-3.0">
      <HintPath>..\lib\drools-3.0.dll</HintPath>
    </Reference>
    <Reference Include="drools-dep">
      <HintPath>..\lib\drools-dep.dll</HintPath>
    </Reference>
    <Reference Include="IKVM.GNU.Classpath">
      <HintPath>..\lib\IKVM.GNU.Classpath.dll</HintPath>
    </Reference>
    <Reference Include="IKVM.Runtime">
      <HintPath>..\lib\IKVM.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="System.CodeDom" Version="8.0.0" />
    <PackageReference Include="System.Security.Permissions" Version="8.0.0" />
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" />
    <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>