<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    
    <!-- Package Metadata -->
    <PackageId>Drools.NET.Modern</PackageId>
    <Version>3.0.0</Version>
    <Authors>Drools.NET Community</Authors>
    <Description>A modern, pure .NET 8 implementation of the Drools rule engine, rewritten from the legacy IKVM-based version for full compatibility with .NET Core/8.</Description>
    <PackageTags>rules;engine;drools;business-rules;rete;decision;net8</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/your-org/drools-dotnet-modern</PackageProjectUrl>
    <RepositoryUrl>https://github.com/your-org/drools-dotnet-modern</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Assembly Metadata -->
    <AssemblyTitle>Drools.NET.Core</AssemblyTitle>
    <AssemblyDescription>Core rule engine implementation</AssemblyDescription>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\Release\net8.0\Drools.NET.Core.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>